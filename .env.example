# ShopFlow Environment Variables
# Copy to .env for local docker-compose or set in your deployment platform

# Database (prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce

# Redis (prod profile)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — use a strong random secret (min 32 chars)
JWT_SECRET=change-me-to-a-very-long-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Mail (MailHog dev / SMTP prod)
MAIL_HOST=localhost
MAIL_PORT=1025
APP_MAIL_ENABLED=true
APP_MAIL_FROM=noreply@shopflow.com

# Uploads
APP_UPLOAD_DIR=uploads

# Public URL (password reset links; Render sets RENDER_EXTERNAL_URL automatically)
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Stripe sandbox (optional — enables Stripe tab in checkout)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Spring profile: dev (H2) | prod (PostgreSQL+Redis) | render (+prod on Render)
SPRING_PROFILES_ACTIVE=dev
